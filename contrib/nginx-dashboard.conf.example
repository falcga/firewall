# Пример включения сайта только на ethernet LAN (слушает 192.168.50.2:8088)
# Сервер по умолчанию не задаём — включите файл из /sites-enabled после правки путей.
server {
  listen 192.168.50.2:8088;
  root /opt/firewall/srv;
  charset utf-8;

  auth_basic           "Firewall";
  auth_basic_user_file /etc/nginx/.firewall_dashboard_htpasswd;

  location /dashboard/ {
    index index.html;
    try_files $uri $uri/ /dashboard/index.html;
  }

  location /dashboard/api/ {
    proxy_pass http://127.0.0.1:8899/;
    proxy_http_version 1.1;
    proxy_connect_timeout 2s;
    proxy_read_timeout 600s;
  }

  ## Опционально: проксировать официальный внешний UI Mihomo после распаковки zip в /etc/mihomo/ui
  # location /mihomo/ {
  #   proxy_pass http://127.0.0.1:9090/;
  #   proxy_redirect off;
  # }
}
