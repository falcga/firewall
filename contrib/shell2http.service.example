# /etc/systemd/system/firewall-shell2http.service
[Unit]
Description=Minimal HTTP bindings for LAN dashboard actions
After=network-online.target

[Service]
Type=simple
User=root
Environment=FIREWALL_ROOT=/opt/firewall
Environment=SHELL2HTTP_LISTEN=127.0.0.1:8899
Environment=SHELL2HTTP_BIN=/usr/local/bin/shell2http
ExecStart=/usr/bin/bash ${FIREWALL_ROOT}/contrib/shell2http-launcher.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
