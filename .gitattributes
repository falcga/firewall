# Автоматически конвертировать CRLF в LF для shell-скриптов
*.sh text eol=lf
*.bash text eol=lf
*.env text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.conf text eol=lf
*.example text eol=lf
*.service text eol=lf

# Бинарники — без конверсии
*.dat binary
*.tar.gz binary
*.zip binary